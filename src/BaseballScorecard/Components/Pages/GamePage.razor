@page "/games/{Id:int}"
@rendermode InteractiveServer
@using System.Globalization
@using BaseballScorecard.Data
@inject GameService GameService

@if (loaded && game is null)
{
    <PageTitle>Game not found</PageTitle>
    <p>Game not found. <a href="games/new">New game</a></p>
}
else if (game is not null)
{
    <PageTitle>@Matchup</PageTitle>

    <h1>@Matchup</h1>

    <LineupEditor GameId="game.Id" RosterId="game.AwayRosterId" Side="away" TeamName="@game.AwayRoster!.TeamName" OnSaved="StateHasChanged" />
    <LineupEditor GameId="game.Id" RosterId="game.HomeRosterId" Side="home" TeamName="@game.HomeRoster!.TeamName" OnSaved="StateHasChanged" />

    <LineScore Game="game" />

    <BattingGrid Game="game" RosterId="game.AwayRosterId" Side="away" TeamName="@game.AwayRoster!.TeamName" />
    <BattingGrid Game="game" RosterId="game.HomeRosterId" Side="home" TeamName="@game.HomeRoster!.TeamName" />

    <PitchersTable GameId="game.Id" RosterId="game.AwayRosterId" Side="away" TeamName="@game.AwayRoster!.TeamName" />
    <PitchersTable GameId="game.Id" RosterId="game.HomeRosterId" Side="home" TeamName="@game.HomeRoster!.TeamName" />
}

@code {
    [Parameter] public int Id { get; set; }

    private Game? game;
    private bool loaded;

    private string Matchup => $"{game!.AwayRoster!.TeamName} @ {game.HomeRoster!.TeamName}";

    protected override async Task OnParametersSetAsync()
    {
        game = await GameService.FindAsync(Id);
        loaded = true;
    }
}
