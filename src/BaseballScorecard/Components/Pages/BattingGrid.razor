@using BaseballScorecard.Data
@inject BattingGridService BattingGridService
@inject LineupService LineupService
@inject PlayerService PlayerService

@* One team's batting grid: an at-bat result per batting slot per inning, picked from a dialog, then HITS and LOB
   per inning, typed by the scorer and saved on change. Side ("away" / "home") prefixes every element id. *@
<section id="@Side-batting-grid">
    <h2>@TeamName batting</h2>

    @if (loaded && rows is null)
    {
        <p id="@Side-batting-grid-empty">Save a lineup to start scoring.</p>
    }
    else if (rows is not null)
    {
        <table class="batting-grid">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Pos</th>
                    @for (var inning = 1; inning <= Game.Innings; inning++)
                    {
                        <th scope="col" class="inning-header">@inning</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var slot = row.Slot;
                    <tr class="batter">
                        <td>@row.Number</td>
                        <td>@row.Name</td>
                        <td>@row.Position</td>
                        @for (var inning = 1; inning <= Game.Innings; inning++)
                        {
                            var n = inning;
                            var id = $"{Side}-slot-{slot}-inning-{n}-note";
                            var note = Note(slot, n);
                            <td>
                                <button id="@id" type="button" class="at-bat-cell" aria-haspopup="dialog"
                                        aria-label="@($"Batting slot {slot}, inning {n}{(note == "" ? "" : $": {note}")}")"
                                        @ref="cellRefs[id]" @onclick="() => Open(id, row, n)">@note</button>
                            </td>
                        }
                    </tr>
                }
                <tr class="totals">
                    <th scope="row" colspan="3">HITS / LOB</th>
                    @for (var inning = 1; inning <= Game.Innings; inning++)
                    {
                        var n = inning;
                        var hitsId = $"{Side}-inning-{n}-hits";
                        var lobId = $"{Side}-inning-{n}-lob";
                        saved.TryGetValue(n, out var t);
                        <td>
                            <input id="@hitsId" type="text" inputmode="numeric" size="2"
                                   aria-label="@TeamName HITS, inning @n"
                                   value="@Text(hitsId, t?.Hits?.ToString())"
                                   @onchange="e => SaveCountAsync(hitsId, n, e.Value as string, BattingGridService.SaveHitsAsync)" />
                            <input id="@lobId" type="text" inputmode="numeric" size="2"
                                   aria-label="@TeamName LOB, inning @n"
                                   value="@Text(lobId, t?.Lob?.ToString())"
                                   @onchange="e => SaveCountAsync(lobId, n, e.Value as string, BattingGridService.SaveLobAsync)" />
                        </td>
                    }
                </tr>
            </tbody>
        </table>
    }

    @if (error is not null)
    {
        <p id="@Side-batting-grid-error" class="validation-message" role="alert">@error</p>
    }

    @if (dialog is { } d)
    {
        <div class="at-bat-backdrop" @onclick="Close"></div>
        <div id="@Side-at-bat-dialog" class="at-bat-dialog" role="dialog" aria-modal="true"
             aria-labelledby="@Side-at-bat-title" tabindex="-1" @ref="dialogRef" @onkeydown="OnDialogKeyDown">
            <button id="@Side-at-bat-close" type="button" class="at-bat-close" aria-label="Close" @onclick="Close">×</button>
            <h3 id="@Side-at-bat-title">@d.Batter, inning @d.Inning</h3>
            <fieldset class="at-bat-results">
                <legend>Result</legend>
                @foreach (var r in AtBatResult.All)
                {
                    var result = r;
                    <label>
                        <input type="radio" name="@Side-at-bat-result" value="@result.Code"
                               checked="@(choice == result.Code)" @onchange="() => choice = result.Code" />
                        <strong>@result.Code</strong> @result.Label
                    </label>
                }
            </fieldset>
            @if (dialogError is not null)
            {
                <p id="@Side-at-bat-error" class="validation-message" role="alert">@dialogError</p>
            }
            <div class="at-bat-actions">
                <button id="@Side-at-bat-save" type="button" disabled="@(choice is null)" @onclick="() => SaveResultAsync(choice)">Save</button>
                <button id="@Side-at-bat-clear" type="button" @onclick="() => SaveResultAsync(null)">Clear</button>
                <button id="@Side-at-bat-cancel" type="button" @onclick="Close">Cancel</button>
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public Game Game { get; set; } = null!;
    [Parameter, EditorRequired] public int RosterId { get; set; }
    [Parameter, EditorRequired] public string Side { get; set; } = "";
    [Parameter, EditorRequired] public string TeamName { get; set; } = "";

    private sealed record BatterRow(int Slot, string Number, string Name, string Position);

    // The 9 batting slots of the saved lineup; null when the team has no saved lineup.
    private List<BatterRow>? rows;
    private bool loaded;
    // Saved notes keyed by (slot, inning); saved HITS / LOB keyed by inning.
    private Dictionary<(int, int), string> notes = [];
    private Dictionary<int, InningHitsLob> saved = [];
    // What a rejected input shows instead, keyed by element id: the text that was typed, so the scorer can fix it.
    private Dictionary<string, string> typed = [];
    private string? error;

    // The open at-bat dialog: which cell it edits, and the result picked so far (null = none).
    private sealed record AtBatDialog(string CellId, int Slot, int Inning, string Batter);
    private AtBatDialog? dialog;
    private string? choice;
    private string? dialogError;
    private ElementReference dialogRef;
    private readonly Dictionary<string, ElementReference> cellRefs = [];
    // Set when the next render must move focus: into the dialog after opening, back to its cell after closing.
    private bool focusDialog;
    private string? focusCellId;

    private string Note(int slot, int inning) => notes.TryGetValue((slot, inning), out var note) ? note : "";

    private string Text(string id, string? savedText) => typed.TryGetValue(id, out var t) ? t : savedText ?? "";

    // Runs on first render and again whenever the game page re-renders (a lineup was saved).
    // The rows go on screen only together with their saved cells, so a box never shows blank before it loads.
    protected override async Task OnParametersSetAsync()
    {
        var lineup = await LineupService.FindAsync(Game.Id, RosterId);
        List<BatterRow>? newRows = null;
        if (lineup is not null)
        {
            var players = (await PlayerService.ListAsync(RosterId)).ToDictionary(p => p.Id);
            // A slot whose player was removed from the roster shows blank; its notes stay with the slot.
            newRows = Enumerable.Range(1, LineupService.SlotCount).Select(n =>
            {
                var s = lineup.Slots.FirstOrDefault(s => s.BattingOrder == n);
                return s is not null && players.TryGetValue(s.PlayerId, out var p)
                    ? new BatterRow(n, p.UniformNumber, $"{p.FirstName} {p.LastName}", Positions.Abbreviation(s.Position))
                    : new BatterRow(n, "", "", "");
            }).ToList();
        }
        await LoadCellsAsync();
        rows = newRows;
        typed = [];
        loaded = true;
    }

    private async Task LoadCellsAsync()
    {
        notes = (await BattingGridService.ListNotesAsync(Game.Id))
            .Where(x => x.RosterId == RosterId).ToDictionary(x => (x.BattingOrder, x.Inning), x => x.Note);
        saved = (await BattingGridService.ListHitsLobAsync(Game.Id))
            .Where(x => x.RosterId == RosterId).ToDictionary(x => x.Inning);
    }

    // A cell holding older free text (or nothing) opens with no result selected.
    private void Open(string cellId, BatterRow row, int inning)
    {
        var batter = row.Name == "" ? $"Batting slot {row.Slot}" : row.Name;
        dialog = new AtBatDialog(cellId, row.Slot, inning, batter);
        choice = AtBatResult.Find(Note(row.Slot, inning))?.Code;
        dialogError = null;
        focusDialog = true;
    }

    private void OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    // Closes without saving and hands focus back to the cell that opened the dialog.
    private void Close()
    {
        focusCellId = dialog?.CellId;
        dialog = null;
        choice = null;
        dialogError = null;
    }

    // Saves the picked result's code, or clears the cell when code is null. A refused save keeps the dialog open with the message.
    private async Task SaveResultAsync(string? code)
    {
        if (dialog is not { } d)
        {
            return;
        }
        dialogError = await BattingGridService.SaveNoteAsync(Game.Id, RosterId, d.Slot, d.Inning, code);
        if (dialogError is not null)
        {
            return;
        }
        await LoadCellsAsync();
        Close();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDialog && dialog is not null)
        {
            focusDialog = false;
            await dialogRef.FocusAsync();
        }
        else if (focusCellId is { } id)
        {
            focusCellId = null;
            if (cellRefs.TryGetValue(id, out var cell))
            {
                await cell.FocusAsync();
            }
        }
    }

    private Task SaveCountAsync(string id, int inning, string? text, Func<int, int, int, string?, Task<string?>> save) =>
        AfterSaveAsync(id, text, save(Game.Id, RosterId, inning, text));

    // A rejected save keeps the typed text on screen with the message. An accepted one clears the message,
    // so every box goes back to what is saved: no refused text is left looking saved.
    private async Task AfterSaveAsync(string id, string? text, Task<string?> save)
    {
        error = await save;
        if (error is not null)
        {
            typed[id] = text ?? "";
            return;
        }
        typed.Clear();
        await LoadCellsAsync();
    }
}
