@using BaseballScorecard.Data
@inject PitchingService PitchingService
@inject PlayerService PlayerService

@* One team's pitchers, in the order the scorer added them, each with a typed-in decision and
   pitching line (IP, BF, BB, SO, H, R, ER), saved on change. Side ("away" / "home") prefixes every element id. *@
<section id="@Side-pitchers">
    <h2>@TeamName pitchers</h2>

    <table>
        <thead>
            <tr>
                <th scope="col">Pitcher</th><th scope="col">Decision</th>
                @foreach (var stat in PitchingStats.All)
                {
                    <th scope="col">@PitchingStats.Label(stat)</th>
                }
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in pitchers)
            {
                var pitcher = row;
                var id = $"{Side}-pitcher-{pitcher.PlayerId}";
                <tr @key="pitcher.Id">
                    <td>@Name(pitcher.PlayerId)</td>
                    <td>
                        <select id="@id-decision" aria-label="@Name(pitcher.PlayerId) decision"
                                value="@pitcher.Decision"
                                @onchange="e => SetDecisionAsync(pitcher, e.Value as string)">
                            @foreach (var d in PitcherDecisions.All)
                            {
                                <option value="@d">@PitcherDecisions.Label(d)</option>
                            }
                        </select>
                    </td>
                    @foreach (var s in PitchingStats.All)
                    {
                        var stat = s;
                        var label = PitchingStats.Label(stat);
                        <td>
                            <input id="@id-@label.ToLowerInvariant()" type="text" inputmode="decimal" size="3"
                                   aria-label="@Name(pitcher.PlayerId) @label"
                                   value="@Text(pitcher, stat)"
                                   @onchange="e => SetStatAsync(pitcher, stat, e.Value as string)" />
                        </td>
                    }
                    <td>
                        <button type="button" id="@id-remove" aria-label="Remove @Name(pitcher.PlayerId)"
                                @onclick="() => RemoveAsync(pitcher)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p>
        <select id="@Side-add-pitcher" aria-label="Add @TeamName pitcher"
                @bind="pickedPlayerId" @bind:after="AddAsync">
            <option value="0">Add pitcher</option>
            @foreach (var p in players)
            {
                <option value="@p.Id" disabled="@pitchers.Any(x => x.PlayerId == p.Id)">@PlayerLabel(p)</option>
            }
        </select>
    </p>

    @if (error is not null)
    {
        <p id="@Side-pitchers-error" class="validation-message" role="alert">@error</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public int GameId { get; set; }
    [Parameter, EditorRequired] public int RosterId { get; set; }
    [Parameter, EditorRequired] public string Side { get; set; } = "";
    [Parameter, EditorRequired] public string TeamName { get; set; } = "";

    private List<Player> players = [];
    private List<GamePitcher> pitchers = [];
    private string? error;
    private int pickedPlayerId;
    // What a rejected box shows instead of its saved value: the text that was typed, so the scorer can fix it.
    private Dictionary<(int PitcherId, PitchingStat Stat), string> typed = [];

    private static string PlayerLabel(Player p) => $"#{p.UniformNumber} {p.FirstName} {p.LastName}";

    private string Name(int playerId) => players.FirstOrDefault(p => p.Id == playerId) is { } p ? PlayerLabel(p) : "";

    protected override async Task OnParametersSetAsync()
    {
        players = await PlayerService.ListAsync(RosterId);
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        pitchers = (await PitchingService.ListAsync(GameId)).Where(p => p.RosterId == RosterId).ToList();

    private string Text(GamePitcher pitcher, PitchingStat stat) =>
        typed.TryGetValue((pitcher.Id, stat), out var t) ? t : PitchingStats.Text(pitcher, stat);

    private async Task SetStatAsync(GamePitcher pitcher, PitchingStat stat, string? value)
    {
        error = await PitchingService.SetStatAsync(GameId, pitcher.Id, stat, value);
        if (error is null)
        {
            typed.Remove((pitcher.Id, stat));
        }
        else
        {
            typed[(pitcher.Id, stat)] = value ?? "";
        }
        await LoadAsync();
    }

    private async Task AddAsync()
    {
        // Back to "Add pitcher": a bound value the render really changes, so the browser shows it
        // and picking a removed pitcher again fires a change.
        var playerId = pickedPlayerId;
        pickedPlayerId = 0;
        if (playerId == 0)
        {
            return;
        }
        error = await PitchingService.AddAsync(GameId, RosterId, playerId);
        await LoadAsync();
    }

    private async Task RemoveAsync(GamePitcher pitcher)
    {
        await PitchingService.RemoveAsync(GameId, pitcher.Id);
        error = null;
        await LoadAsync();
    }

    private async Task SetDecisionAsync(GamePitcher pitcher, string? value)
    {
        error = Enum.TryParse<PitcherDecision>(value, out var decision)
            ? await PitchingService.SetDecisionAsync(GameId, pitcher.Id, decision)
            : PitchingService.DecisionMessage;
        await LoadAsync();
    }
}
