@inherits LayoutComponentBase

<header class="app-header">
    <span class="brand">Baseball Scorecard</span>
    <div class="header-end">
        <nav class="app-nav" aria-label="Main">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="rosters">Rosters</NavLink>
            <NavLink href="games/new">New game</NavLink>
        </nav>
        @* A plain button: theme.js flips data-theme on <html> and keeps the label current. *@
        <button type="button" class="theme-toggle" aria-label="Switch to dark mode">Dark mode</button>
    </div>
</header>

<main class="app-main">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
